{
  "name": "search-engine",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:server": "bun run src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "build": "vite build",
    "serve": "NODE_ENV=production bun run src/server/index.ts",
    "start": "bun run build && bun run serve"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.0",
    "daisyui": "^5.5.20",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@huggingface/transformers": "^4.2.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28",
    "ioredis": "^5.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "remark-gfm": "^4.0.1"
  }
}
